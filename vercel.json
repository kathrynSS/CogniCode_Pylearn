{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python@3.9.5"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "env": {
    "FLASK_ENV": "production",
    "MAX_FILE_SIZE": "16777216",
    "UPLOAD_FOLDER": "Resources"
  },
  "functions": {
    "app.py": {
      "maxDuration": 30
    }
  }
} 