{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.7.2",
      "maxDuration": 120
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "FLASK_ENV": "production",
    "MAX_FILE_SIZE": "16777216",
    "UPLOAD_FOLDER": "Resources"
  }
} 