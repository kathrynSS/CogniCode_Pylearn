# 数据库配置
# PostgreSQL 连接字符串（推荐使用Neon数据库）
# Neon会自动提供此连接字符串
POSTGRES_URL=postgresql://username:password@hostname/database
# 或者使用Vercel的标准环境变量
DATABASE_URL=postgresql://username:password@hostname/database

# 可选：如果没有POSTGRES_URL，将使用SQLite进行本地开发
# DATABASE_URL=sqlite:///app_database.db

# AI API 配置
# DeepSeek API密钥（用于AI聊天功能）
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Google Drive 集成（可选）
# 方式1：JSON格式的服务账号凭据
GOOGLE_DRIVE_CREDENTIALS={"type":"service_account","project_id":"your-project",...}

# 方式2：凭据文件路径
GOOGLE_DRIVE_CREDENTIALS_PATH=path/to/your/service-account-key.json

# Google Drive 资源文件夹ID
RESOURCES_FOLDER_ID=your-google-drive-folder-id

# Flask 配置
FLASK_ENV=production
SECRET_KEY=your-secret-key-here

# 文件上传配置
MAX_FILE_SIZE=16777216  # 16MB in bytes
UPLOAD_FOLDER=Resources 